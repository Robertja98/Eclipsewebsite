# Ignore these folders anywhere in the repo
CRM/
**/CRM/

flash/
**/flash/

# If the folder name contains a space, you can still list it directly
cancellation page/
**/cancellation page/

# OS files
.DS_Store
Thumbs.db

# Log files
*.log
error_log

# Data exports
*.csv
*.xls
*.xlsx
*.bak

# Environment/config
.env
.env.*

# Composer dependencies
/vendor/
composer.lock

# Node dependencies (if any)
/node_modules/
package-lock.json
yarn.lock

# IDE/project files
*.sublime*
*.vscode/
*.idea/
*.code-workspace

# Cache/temp
.cache/
*.tmp
*.swp

# System folders
__pycache__/

# Python virtual environments (if ever used)
venv/

# Misc
*.bak
*.orig

# Ignore deployment/test files
/deploy/
/test/

# Ignore debug and session files
*.sess
*.pid

# Ignore images generated by scripts
*.out.png
*.out.jpg

# Ignore backup files
*~

# Ignore Flask folder if not needed in prod
/Flask/
